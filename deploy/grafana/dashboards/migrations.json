{
  "uid": "batch-migrations",
  "title": "Batch Migrations",
  "tags": [
    "if3110",
    "migrations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Batch selesai per status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(migration_batch_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Item selesai per status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(migration_batch_items_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Durasi item p50 / p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (migration_item_duration_seconds_bucket))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (migration_item_duration_seconds_bucket))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (migration_item_duration_seconds_bucket))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Durasi batch p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (migration_batch_duration_seconds_bucket))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Batch selesai (rentang)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(migration_batch_total[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Batch gagal + sebagian (rentang)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(migration_batch_total{status=~\"failed|partial\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Item sukses (rentang)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(migration_batch_items_total{status=\"success\"}[$__range])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job per status (saat ini)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "migration_jobs",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Waktu tunggu queue p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(migration_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Durasi migration p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(migration_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Koneksi pool database",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "db_pool_connections{state=\"in_use\"}",
          "legendFormat": "in_use"
        },
        {
          "expr": "db_pool_connections{state=\"idle\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "db_pool_max_connections",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retry & lock busy per 5 menit",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(migration_retries_total[5m]))",
          "legendFormat": "retry"
        },
        {
          "expr": "sum(increase(migration_lock_busy_total[5m]))",
          "legendFormat": "lock busy"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total waktu tunggu koneksi",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "db_pool_wait_seconds_total",
          "legendFormat": "kumulatif"
        }
      ]
    }
  ]
}
